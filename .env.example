# Copie para .env (que NÃO vai para o Git) e ajuste.

# demo   = dados simulados, não precisa de Zabbix
# zabbix = dados reais (preencha as duas linhas abaixo)
NOC_MODE=demo

# ZABBIX_URL=https://seu-zabbix/zabbix/api_jsonrpc.php
# ZABBIX_API_TOKEN=token-de-um-usuario-somente-leitura

# Locais do globo: "config" (backend/config.py) ou "inventory"
# (inventário de cada host no Zabbix: Location, Latitude, Longitude)
# NOC_LOCATIONS_FROM=inventory
# Opcional: só hosts com esta tag entram no globo
# NOC_HOST_TAG=noc

# SLO: meta de disponibilidade (%) e severidade mínima que conta como queda
# (0 Not classified, 1 Information, 2 Warning, 3 Average, 4 High, 5 Disaster)
# NOC_SLO_TARGET=99.5
# NOC_SLO_MIN_SEVERITY=4

# Porta local do painel
NOC_PORT=8080
